        </mxCell>
        <mxCell id="s" parent="1" vertex="1" value="Concrete resource boundaries and route ownership • blue = initiating packet • green = reply • purple dashed = policy/control" style="shape=rectangle;rounded=1;arcSize=6;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=20;fontFamily=Arial;fontSize=25;fontColor=#15283f;fillColor=none;strokeColor=none;strokeWidth=2;spacing=0;">
