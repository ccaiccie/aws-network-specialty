  <diagram id="aws-10" name="10 Network Firewall rules and TLS inspection">
    <mxGraphModel dx="2400" dy="1740" grid="1" gridSize="10" page="1" pageScale="1" pageWidth="2400" pageHeight="1740" background="#ffffff" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="eyebrow" value="AWS  /  PACKET INSPECTION ATLAS  /  10 OF 12" vertex="1" parent="1" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=22;fontFamily=Arial;fontSize=24;fontColor=#15283f;fillColor=none;strokeColor=none;strokeWidth=2;spacing=0;">
          <mxGeometry as="geometry" x="60" y="30" width="2280" height="42" />
        </mxCell>
        <mxCell id="title" value="Network Firewall rules and TLS inspection" vertex="1" parent="1" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=22;fontFamily=Arial;fontSize=44;fontColor=#15283f;fillColor=none;strokeColor=none;strokeWidth=2;spacing=0;">
          <mxGeometry as="geometry" x="60" y="84" width="2280" height="76" />
        </mxCell>
        <mxCell id="scope" value="Engine walk • logical processing stages rather than physical appliances" vertex="1" parent="1" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=22;fontFamily=Arial;fontSize=26;fontColor=#15283f;fillColor=none;strokeColor=none;strokeWidth=2;spacing=0;">
          <mxGeometry as="geometry" x="60" y="170" width="2280" height="50" />
        </mxCell>
        <mxCell id="fwd" value="FORWARD   →   Read steps 1–5 from left to right" vertex="1" parent="1" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=22;fontFamily=Arial;fontSize=24;fontColor=#15283f;fillColor=none;strokeColor=none;strokeWidth=2;spacing=0;">
          <mxGeometry as="geometry" x="60" y="240" width="2280" height="42" />
        </mxCell>
        <mxCell id="f0" value="&lt;b&gt;01  Stateless rules&lt;/b&gt;&lt;br&gt;&lt;br&gt;Packets are evaluated against stateless rules and defaults. forward_to_sfe sends traffic to the stateful engine; a stateless pass can bypass that engine." vertex="1" parent="1" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=22;fontFamily=Arial;fontSize=22;fontColor=#15283f;fillColor=#eff6ff;strokeColor=#80a9d5;strokeWidth=2;">
          <mxGeometry as="geometry" x="60" y="300" width="400" height="330" />
        </mxCell>
        <mxCell id="f1" value="&lt;b&gt;02  Stateful stream&lt;/b&gt;&lt;br&gt;&lt;br&gt;The firewall tracks/reassembles supported flows. Strict-order and default-action-order policies evaluate rule groups differently; choose deliberately." vertex="1" parent="1" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=22;fontFamily=Arial;fontSize=22;fontColor=#15283f;fillColor=#eff6ff;strokeColor=#80a9d5;strokeWidth=2;">
          <mxGeometry as="geometry" x="520" y="300" width="400" height="330" />
        </mxCell>
        <mxCell id="f2" value="&lt;b&gt;03  TLS inspection&lt;/b&gt;&lt;br&gt;&lt;br&gt;For configured supported TLS flows, the service terminates and re-establishes TLS using the TLS inspection configuration and certificates." vertex="1" parent="1" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=22;fontFamily=Arial;fontSize=22;fontColor=#15283f;fillColor=#eff6ff;strokeColor=#80a9d5;strokeWidth=2;">
          <mxGeometry as="geometry" x="980" y="300" width="400" height="330" />
        </mxCell>
        <mxCell id="f3" value="&lt;b&gt;04  Content verdict&lt;/b&gt;&lt;br&gt;&lt;br&gt;Suricata-compatible rules and configured application/domain criteria inspect available data. Encrypted bypass traffic has less visibility." vertex="1" parent="1" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=22;fontFamily=Arial;fontSize=22;fontColor=#15283f;fillColor=#eff6ff;strokeColor=#80a9d5;strokeWidth=2;">
          <mxGeometry as="geometry" x="1440" y="300" width="400" height="330" />
        </mxCell>
        <mxCell id="f4" value="&lt;b&gt;05  Forward or drop&lt;/b&gt;&lt;br&gt;&lt;br&gt;Allowed traffic continues along the endpoint route. A rule log and a delivered response are different pieces of evidence." vertex="1" parent="1" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=22;fontFamily=Arial;fontSize=22;fontColor=#15283f;fillColor=#eff6ff;strokeColor=#80a9d5;strokeWidth=2;">
          <mxGeometry as="geometry" x="1900" y="300" width="400" height="330" />
        </mxCell>
        <mxCell id="fe0" parent="1" source="f0" target="f1" edge="1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=4;strokeColor=#2466a8;">
          <mxGeometry as="geometry" relative="1" />
        </mxCell>
        <mxCell id="fe1" parent="1" source="f1" target="f2" edge="1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=4;strokeColor=#2466a8;">
          <mxGeometry as="geometry" relative="1" />
        </mxCell>
        <mxCell id="fe2" parent="1" source="f2" target="f3" edge="1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=4;strokeColor=#2466a8;">
          <mxGeometry as="geometry" relative="1" />
        </mxCell>
        <mxCell id="fe3" parent="1" source="f3" target="f4" edge="1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=4;strokeColor=#2466a8;">
          <mxGeometry as="geometry" relative="1" />
        </mxCell>
        <mxCell id="rev" value="RETURN   ←   Start at step 6 on the right; follow steps 6–10 back to the source" vertex="1" parent="1" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=22;fontFamily=Arial;fontSize=24;fontColor=#15283f;fillColor=none;strokeColor=none;strokeWidth=2;spacing=0;">
          <mxGeometry as="geometry" x="60" y="680" width="2280" height="42" />
        </mxCell>
        <mxCell id="r0" value="&lt;b&gt;10  Client receive&lt;/b&gt;&lt;br&gt;&lt;br&gt;Client receives permitted data on the expected connection." vertex="1" parent="1" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=22;fontFamily=Arial;fontSize=23;fontColor=#15283f;fillColor=#eef9f4;strokeColor=#77ad95;strokeWidth=2;">
          <mxGeometry as="geometry" x="60" y="740" width="400" height="255" />
        </mxCell>
        <mxCell id="r1" value="&lt;b&gt;09  Client TLS leg&lt;/b&gt;&lt;br&gt;&lt;br&gt;When decrypted, the service re-encrypts toward the client." vertex="1" parent="1" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=22;fontFamily=Arial;fontSize=23;fontColor=#15283f;fillColor=#eef9f4;strokeColor=#77ad95;strokeWidth=2;">
          <mxGeometry as="geometry" x="520" y="740" width="400" height="255" />
        </mxCell>
        <mxCell id="r2" value="&lt;b&gt;08  Reverse stream&lt;/b&gt;&lt;br&gt;&lt;br&gt;Stateful processing evaluates the reverse stream as applicable." vertex="1" parent="1" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=22;fontFamily=Arial;fontSize=23;fontColor=#15283f;fillColor=#eef9f4;strokeColor=#77ad95;strokeWidth=2;">
          <mxGeometry as="geometry" x="980" y="740" width="400" height="255" />
        </mxCell>
        <mxCell id="r3" value="&lt;b&gt;07  Server TLS leg&lt;/b&gt;&lt;br&gt;&lt;br&gt;The independent origin session delivers the response to the inspection service." vertex="1" parent="1" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=22;fontFamily=Arial;fontSize=23;fontColor=#15283f;fillColor=#eef9f4;strokeColor=#77ad95;strokeWidth=2;">
          <mxGeometry as="geometry" x="1440" y="740" width="400" height="255" />
        </mxCell>
        <mxCell id="r4" value="&lt;b&gt;06  Server response&lt;/b&gt;&lt;br&gt;&lt;br&gt;Without TLS inspection, payload remains opaque even though connection metadata is visible." vertex="1" parent="1" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=22;fontFamily=Arial;fontSize=23;fontColor=#15283f;fillColor=#eef9f4;strokeColor=#77ad95;strokeWidth=2;">
          <mxGeometry as="geometry" x="1900" y="740" width="400" height="255" />
        </mxCell>
        <mxCell id="re0" parent="1" source="r1" target="r0" edge="1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=4;strokeColor=#25825b;">
          <mxGeometry as="geometry" relative="1" />
        </mxCell>
        <mxCell id="re1" parent="1" source="r2" target="r1" edge="1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=4;strokeColor=#25825b;">
          <mxGeometry as="geometry" relative="1" />
        </mxCell>
        <mxCell id="re2" parent="1" source="r3" target="r2" edge="1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=4;strokeColor=#25825b;">
          <mxGeometry as="geometry" relative="1" />
        </mxCell>
        <mxCell id="re3" parent="1" source="r4" target="r3" edge="1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=4;strokeColor=#25825b;">
          <mxGeometry as="geometry" relative="1" />
        </mxCell>
        <mxCell id="route" value="&lt;b&gt;ROUTING / CONTROL PLANE&lt;/b&gt;&lt;br&gt;&lt;br&gt;Both directions must traverse the compatible firewall endpoint. Set HOME_NET and rule variables for all inspected source domains in centralized designs; the inspection VPC CIDR alone may not describe spoke clients." vertex="1" parent="1" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=22;fontFamily=Arial;fontSize=24;fontColor=#15283f;fillColor=#f2f0fa;strokeColor=#cbd5e1;strokeWidth=2;">
          <mxGeometry as="geometry" x="60" y="1060" width="720" height="365" />
        </mxCell>
        <mxCell id="policy" value="&lt;b&gt;INSPECTION / IDENTITY&lt;/b&gt;&lt;br&gt;&lt;br&gt;Strict-order drop-established defaults allow application identification before a final verdict in suitable designs. Broad IP pass rules can prevent intended application restrictions. Validate the exact Suricata semantics of each rule." vertex="1" parent="1" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=22;fontFamily=Arial;fontSize=24;fontColor=#15283f;fillColor=#fff7e7;strokeColor=#cbd5e1;strokeWidth=2;">
          <mxGeometry as="geometry" x="840" y="1060" width="720" height="365" />
        </mxCell>
        <mxCell id="failure" value="&lt;b&gt;FAILURE / PROOF&lt;/b&gt;&lt;br&gt;&lt;br&gt;Test plaintext, decrypted TLS, unsupported/pinned clients and an explicit deny. Verify certificate trust, TLS logs, alert logs and application outcome. Do not use real malware for acceptance tests." vertex="1" parent="1" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=22;fontFamily=Arial;fontSize=24;fontColor=#15283f;fillColor=#fff0ef;strokeColor=#cbd5e1;strokeWidth=2;">
          <mxGeometry as="geometry" x="1620" y="1060" width="720" height="365" />
        </mxCell>
        <mxCell id="sources" value="REFERENCES — full clickable source links and validation commands are in the companion Markdown report." vertex="1" parent="1" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=22;fontFamily=Arial;fontSize=24;fontColor=#15283f;fillColor=none;strokeColor=none;strokeWidth=2;spacing=0;">
          <mxGeometry as="geometry" x="60" y="1470" width="2280" height="40" />
        </mxCell>
        <mxCell id="sourcelinks" value="&lt;a href=&quot;https://docs.aws.amazon.com/network-firewall/latest/developerguide/firewall-rules-engines.html&quot;&gt;https://docs.aws.amazon.com/network-firewall/latest/developerguide/firewall-rules-engines.html&lt;/a&gt;&lt;br&gt;&lt;a href=&quot;https://docs.aws.amazon.com/network-firewall/latest/developerguide/tls-inspection.html&quot;&gt;https://docs.aws.amazon.com/network-firewall/latest/developerguide/tls-inspection.html&lt;/a&gt;" vertex="1" parent="1" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=22;fontFamily=Arial;fontSize=21;fontColor=#15283f;fillColor=none;strokeColor=none;strokeWidth=2;spacing=0;">
          <mxGeometry as="geometry" x="60" y="1520" width="2280" height="105" />
        </mxCell>
        <mxCell id="footer" value="Illustrative addresses • logical service hops • blue = initiating traffic • green = response • control-plane notes are not packet hops" vertex="1" parent="1" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=22;fontFamily=Arial;fontSize=22;fontColor=#15283f;fillColor=none;strokeColor=none;strokeWidth=2;spacing=0;">
          <mxGeometry as="geometry" x="60" y="1660" width="2280" height="45" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="aws-11" name="11 GWLB overlay routing — vendor DMZ variant">
    <mxGraphModel dx="2400" dy="1740" grid="1" gridSize="10" page="1" pageScale="1" pageWidth="2400" pageHeight="1740" background="#ffffff" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="eyebrow" value="AWS  /  PACKET INSPECTION ATLAS  /  11 OF 12" vertex="1" parent="1" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=22;fontFamily=Arial;fontSize=24;fontColor=#15283f;fillColor=none;strokeColor=none;strokeWidth=2;spacing=0;">
          <mxGeometry as="geometry" x="60" y="30" width="2280" height="42" />
        </mxCell>
        <mxCell id="title" value="GWLB overlay routing — vendor DMZ variant" vertex="1" parent="1" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=22;fontFamily=Arial;fontSize=44;fontColor=#15283f;fillColor=none;strokeColor=none;strokeWidth=2;spacing=0;">
          <mxGeometry as="geometry" x="60" y="84" width="2280" height="76" />
        </mxCell>
        <mxCell id="scope" value="VM-Series-specific architecture • not a universal GWLB feature" vertex="1" parent="1" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=22;fontFamily=Arial;fontSize=26;fontColor=#15283f;fillColor=none;strokeColor=none;strokeWidth=2;spacing=0;">
          <mxGeometry as="geometry" x="60" y="170" width="2280" height="50" />
        </mxCell>
        <mxCell id="fwd" value="FORWARD   →   Read steps 1–5 from left to right" vertex="1" parent="1" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=22;fontFamily=Arial;fontSize=24;fontColor=#15283f;fillColor=none;strokeColor=none;strokeWidth=2;spacing=0;">
          <mxGeometry as="geometry" x="60" y="240" width="2280" height="42" />
        </mxCell>
        <mxCell id="f0" value="&lt;b&gt;01  Ingress endpoint&lt;/b&gt;&lt;br&gt;&lt;br&gt;AWS route selection sends the flow to the designated GWLBE. Endpoint identity identifies the service-chain entry context." vertex="1" parent="1" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=22;fontFamily=Arial;fontSize=22;fontColor=#15283f;fillColor=#eff6ff;strokeColor=#80a9d5;strokeWidth=2;">
          <mxGeometry as="geometry" x="60" y="300" width="400" height="330" />
        </mxCell>
        <mxCell id="f1" value="&lt;b&gt;02  GENEVE delivery&lt;/b&gt;&lt;br&gt;&lt;br&gt;GWLB carries the original packet and service metadata to VM-Series. Vendor plugin/configuration maps supported endpoint context to the intended zone." vertex="1" parent="1" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=22;fontFamily=Arial;fontSize=22;fontColor=#15283f;fillColor=#eff6ff;strokeColor=#80a9d5;strokeWidth=2;">
          <mxGeometry as="geometry" x="520" y="300" width="400" height="330" />
        </mxCell>
        <mxCell id="f2" value="&lt;b&gt;03  Inner-header routing&lt;/b&gt;&lt;br&gt;&lt;br&gt;With the supported overlay-routing feature configured, PAN-OS performs an inner-packet route lookup and security policy processing." vertex="1" parent="1" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=22;fontFamily=Arial;fontSize=22;fontColor=#15283f;fillColor=#eff6ff;strokeColor=#80a9d5;strokeWidth=2;">
          <mxGeometry as="geometry" x="980" y="300" width="400" height="330" />
        </mxCell>
        <mxCell id="f3" value="&lt;b&gt;04  DMZ / trust egress&lt;/b&gt;&lt;br&gt;&lt;br&gt;The appliance forwards to the configured routed destination instead of assuming every design is simple transparent return-to-source-endpoint inspection." vertex="1" parent="1" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=22;fontFamily=Arial;fontSize=22;fontColor=#15283f;fillColor=#eff6ff;strokeColor=#80a9d5;strokeWidth=2;">
          <mxGeometry as="geometry" x="1440" y="300" width="400" height="330" />
        </mxCell>
        <mxCell id="f4" value="&lt;b&gt;05  Application&lt;/b&gt;&lt;br&gt;&lt;br&gt;The backend receives the selected translated or original tuple. Its return route must lead into the correct vendor session and zone context." vertex="1" parent="1" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=22;fontFamily=Arial;fontSize=22;fontColor=#15283f;fillColor=#eff6ff;strokeColor=#80a9d5;strokeWidth=2;">
          <mxGeometry as="geometry" x="1900" y="300" width="400" height="330" />
        </mxCell>
        <mxCell id="fe0" parent="1" source="f0" target="f1" edge="1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=4;strokeColor=#2466a8;">
          <mxGeometry as="geometry" relative="1" />
        </mxCell>
        <mxCell id="fe1" parent="1" source="f1" target="f2" edge="1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=4;strokeColor=#2466a8;">
          <mxGeometry as="geometry" relative="1" />
        </mxCell>
        <mxCell id="fe2" parent="1" source="f2" target="f3" edge="1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=4;strokeColor=#2466a8;">
          <mxGeometry as="geometry" relative="1" />
        </mxCell>
        <mxCell id="fe3" parent="1" source="f3" target="f4" edge="1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=4;strokeColor=#2466a8;">
          <mxGeometry as="geometry" relative="1" />
        </mxCell>
        <mxCell id="rev" value="RETURN   ←   Start at step 6 on the right; follow steps 6–10 back to the source" vertex="1" parent="1" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=22;fontFamily=Arial;fontSize=24;fontColor=#15283f;fillColor=none;strokeColor=none;strokeWidth=2;spacing=0;">
          <mxGeometry as="geometry" x="60" y="680" width="2280" height="42" />
        </mxCell>
        <mxCell id="r0" value="&lt;b&gt;10  Original client&lt;/b&gt;&lt;br&gt;&lt;br&gt;Reverse NAT/session processing restores the expected service tuple." vertex="1" parent="1" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=22;fontFamily=Arial;fontSize=23;fontColor=#15283f;fillColor=#eef9f4;strokeColor=#77ad95;strokeWidth=2;">
          <mxGeometry as="geometry" x="60" y="740" width="400" height="255" />
        </mxCell>
        <mxCell id="r1" value="&lt;b&gt;09  AWS egress path&lt;/b&gt;&lt;br&gt;&lt;br&gt;The supported vendor/AWS design delivers the response through the correct endpoint/public path." vertex="1" parent="1" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=22;fontFamily=Arial;fontSize=23;fontColor=#15283f;fillColor=#eef9f4;strokeColor=#77ad95;strokeWidth=2;">
          <mxGeometry as="geometry" x="520" y="740" width="400" height="255" />
        </mxCell>
        <mxCell id="r2" value="&lt;b&gt;08  Vendor session&lt;/b&gt;&lt;br&gt;&lt;br&gt;PAN-OS matches security zones, routing and NAT state." vertex="1" parent="1" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=22;fontFamily=Arial;fontSize=23;fontColor=#15283f;fillColor=#eef9f4;strokeColor=#77ad95;strokeWidth=2;">
          <mxGeometry as="geometry" x="980" y="740" width="400" height="255" />
        </mxCell>
        <mxCell id="r3" value="&lt;b&gt;07  DMZ return route&lt;/b&gt;&lt;br&gt;&lt;br&gt;The backend reaches the correct inspection interface or endpoint path." vertex="1" parent="1" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=22;fontFamily=Arial;fontSize=23;fontColor=#15283f;fillColor=#eef9f4;strokeColor=#77ad95;strokeWidth=2;">
          <mxGeometry as="geometry" x="1440" y="740" width="400" height="255" />
        </mxCell>
        <mxCell id="r4" value="&lt;b&gt;06  Backend reply&lt;/b&gt;&lt;br&gt;&lt;br&gt;A generic GWLB stickiness claim does not establish this routed return design." vertex="1" parent="1" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=22;fontFamily=Arial;fontSize=23;fontColor=#15283f;fillColor=#eef9f4;strokeColor=#77ad95;strokeWidth=2;">
          <mxGeometry as="geometry" x="1900" y="740" width="400" height="255" />
        </mxCell>
        <mxCell id="re0" parent="1" source="r1" target="r0" edge="1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=4;strokeColor=#25825b;">
          <mxGeometry as="geometry" relative="1" />
        </mxCell>
        <mxCell id="re1" parent="1" source="r2" target="r1" edge="1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=4;strokeColor=#25825b;">
          <mxGeometry as="geometry" relative="1" />
        </mxCell>
        <mxCell id="re2" parent="1" source="r3" target="r2" edge="1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=4;strokeColor=#25825b;">
          <mxGeometry as="geometry" relative="1" />
        </mxCell>
        <mxCell id="re3" parent="1" source="r4" target="r3" edge="1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=4;strokeColor=#25825b;">
          <mxGeometry as="geometry" relative="1" />
        </mxCell>
        <mxCell id="route" value="&lt;b&gt;ROUTING / CONTROL PLANE&lt;/b&gt;&lt;br&gt;&lt;br&gt;Treat endpoint-to-zone mapping, plugin/version requirements and the PAN-OS virtual-router configuration as mandatory prerequisites. TGW Connect GRE/BGP is a separate overlay mechanism." vertex="1" parent="1" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=22;fontFamily=Arial;fontSize=24;fontColor=#15283f;fillColor=#f2f0fa;strokeColor=#cbd5e1;strokeWidth=2;">
          <mxGeometry as="geometry" x="60" y="1060" width="720" height="365" />
        </mxCell>
        <mxCell id="policy" value="&lt;b&gt;INSPECTION / IDENTITY&lt;/b&gt;&lt;br&gt;&lt;br&gt;The earlier knowledge material includes this vendor-specific case. Validate against the selected VM-Series release rather than translating it to another vendor or enabling it on a basic transparent lab." vertex="1" parent="1" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=22;fontFamily=Arial;fontSize=24;fontColor=#15283f;fillColor=#fff7e7;strokeColor=#cbd5e1;strokeWidth=2;">
          <mxGeometry as="geometry" x="840" y="1060" width="720" height="365" />
        </mxCell>
        <mxCell id="failure" value="&lt;b&gt;FAILURE / PROOF&lt;/b&gt;&lt;br&gt;&lt;br&gt;Record endpoint ID, ingress zone, inner destination, chosen route, egress zone and NAT rule for both directions. Test an explicit DMZ deny and session recovery after target failure." vertex="1" parent="1" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=22;fontFamily=Arial;fontSize=24;fontColor=#15283f;fillColor=#fff0ef;strokeColor=#cbd5e1;strokeWidth=2;">
          <mxGeometry as="geometry" x="1620" y="1060" width="720" height="365" />
        </mxCell>
        <mxCell id="sources" value="REFERENCES — full clickable source links and validation commands are in the companion Markdown report." vertex="1" parent="1" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=22;fontFamily=Arial;fontSize=24;fontColor=#15283f;fillColor=none;strokeColor=none;strokeWidth=2;spacing=0;">
          <mxGeometry as="geometry" x="60" y="1470" width="2280" height="40" />
        </mxCell>
        <mxCell id="sourcelinks" value="&lt;a href=&quot;https://docs.paloaltonetworks.com/vm-series/11-1/vm-series-deployment/set-up-the-vm-series-firewall-on-aws/vm-series-integration-with-gateway-load-balancer&quot;&gt;https://docs.paloaltonetworks.com/vm-series/11-1/vm-series-deployment/set-up-the-vm-series-firewall-on-aws/vm-series-integration-with-gateway-load-balancer&lt;/a&gt;" vertex="1" parent="1" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=22;fontFamily=Arial;fontSize=21;fontColor=#15283f;fillColor=none;strokeColor=none;strokeWidth=2;spacing=0;">
          <mxGeometry as="geometry" x="60" y="1520" width="2280" height="105" />
        </mxCell>
        <mxCell id="footer" value="Illustrative addresses • logical service hops • blue = initiating traffic • green = response • control-plane notes are not packet hops" vertex="1" parent="1" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=22;fontFamily=Arial;fontSize=22;fontColor=#15283f;fillColor=none;strokeColor=none;strokeWidth=2;spacing=0;">
