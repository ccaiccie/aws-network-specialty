        <mxCell id="c" parent="1" edge="1" source="nat" target="fw" value="5 • reverse NAT" style="edgeStyle=orthogonalEdgeStyle;html=1;rounded=0;strokeWidth=4;endArrow=block;endFill=1;strokeColor=#25825b;fontColor=#25825b;fontSize=22;labelBackgroundColor=#ffffff;exitX=0;exitY=0.75;entryX=1;entryY=0.75;">
          <mxGeometry as="geometry" relative="1" />
        </mxCell>
        <mxCell id="d" parent="1" edge="1" source="fw" target="vm" value="6 • stateful reply" style="edgeStyle=orthogonalEdgeStyle;html=1;rounded=0;strokeWidth=4;endArrow=block;endFill=1;strokeColor=#25825b;fontColor=#25825b;fontSize=22;labelBackgroundColor=#ffffff;exitX=0;exitY=0.75;entryX=1;entryY=0.75;">
          <mxGeometry as="geometry" relative="1" />
        </mxCell>
        <mxCell id="pol" parent="1" vertex="1" value="&lt;b&gt;Policy and evidence&lt;/b&gt;&lt;br&gt;Stateless defaults → stateful engine&lt;br&gt;Strict order; transport allows TCP/80 and TCP/443&lt;br&gt;Drop-established default for other established traffic&lt;br&gt;CloudWatch FLOW and ALERT logs" style="shape=rectangle;rounded=1;arcSize=6;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=20;fontFamily=Arial;fontSize=25;fontColor=#15283f;fillColor=#f2f0fa;strokeColor=#7fa2c5;strokeWidth=2;">
