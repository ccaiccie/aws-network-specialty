        </mxCell>
        <mxCell id="net" parent="1" vertex="1" value="&lt;b&gt;Internet server&lt;/b&gt;&lt;br&gt;Reply to NAT EIP" style="shape=cloud;rounded=1;arcSize=6;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=20;fontFamily=Arial;fontSize=25;fontColor=#15283f;fillColor=#eef9f4;strokeColor=#7fa2c5;strokeWidth=2;align=center;">
