        </mxCell>
        <mxCell id="s1" parent="1" vertex="1" value="WORKLOAD SUBNET 10.10.1.0/24" style="shape=rectangle;rounded=1;arcSize=6;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=20;fontFamily=Arial;fontSize=25;fontColor=#15283f;fillColor=#ffffff;strokeColor=#7fa2c5;strokeWidth=2;">
          <mxGeometry as="geometry" x="90" y="330" width="660" height="650" />
        </mxCell>
        <mxCell id="s2" parent="1" vertex="1" value="FIREWALL SUBNET 10.10.2.0/24" style="shape=rectangle;rounded=1;arcSize=6;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=20;fontFamily=Arial;fontSize=25;fontColor=#15283f;fillColor=#ffffff;strokeColor=#7fa2c5;strokeWidth=2;">
          <mxGeometry as="geometry" x="860" y="330" width="660" height="650" />
        </mxCell>
        <mxCell id="s3" parent="1" vertex="1" value="PUBLIC NAT SUBNET 10.10.3.0/24" style="shape=rectangle;rounded=1;arcSize=6;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=20;fontFamily=Arial;fontSize=25;fontColor=#15283f;fillColor=#ffffff;strokeColor=#7fa2c5;strokeWidth=2;">
          <mxGeometry as="geometry" x="1630" y="330" width="660" height="650" />
        </mxCell>
        <mxCell id="vm" parent="1" vertex="1" value="&lt;b&gt;Private EC2 / SSM&lt;/b&gt;&lt;br&gt;t3.micro • no inbound SG rule&lt;br&gt;TCP/80 and TCP/443 test traffic" style="shape=rectangle;rounded=1;arcSize=6;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=20;fontFamily=Arial;fontSize=25;fontColor=#15283f;fillColor=#eff6ff;strokeColor=#7fa2c5;strokeWidth=2;">
          <mxGeometry as="geometry" x="150" y="440" width="540" height="170" />
        </mxCell>
        <mxCell id="fw" parent="1" vertex="1" value="&lt;b&gt;Network Firewall endpoint&lt;/b&gt;&lt;br&gt;Same-AZ managed inspection&lt;br&gt;Original source before NAT" style="shape=hexagon;rounded=1;arcSize=6;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=20;fontFamily=Arial;fontSize=25;fontColor=#15283f;fillColor=#fff0dc;strokeColor=#7fa2c5;strokeWidth=2;align=center;">
          <mxGeometry as="geometry" x="920" y="440" width="540" height="170" />
        </mxCell>
        <mxCell id="nat" parent="1" vertex="1" value="&lt;b&gt;NAT Gateway&lt;/b&gt;&lt;br&gt;Public EIP owns translation&lt;br&gt;Private workload source → EIP" style="shape=rectangle;rounded=1;arcSize=6;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=20;fontFamily=Arial;fontSize=25;fontColor=#15283f;fillColor=#eef9f4;strokeColor=#7fa2c5;strokeWidth=2;">
          <mxGeometry as="geometry" x="1690" y="440" width="540" height="170" />
        </mxCell>
        <mxCell id="rt1" parent="1" vertex="1" value="&lt;b&gt;Workload route table&lt;/b&gt;&lt;br&gt;0.0.0.0/0 → firewall endpoint&lt;br&gt;VPC local route unchanged&lt;br&gt;SG allows egress; no ingress opening" style="shape=rectangle;rounded=1;arcSize=6;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=20;fontFamily=Arial;fontSize=25;fontColor=#15283f;fillColor=#f2f0fa;strokeColor=#7fa2c5;strokeWidth=2;">
          <mxGeometry as="geometry" x="150" y="720" width="540" height="200" />
        </mxCell>
        <mxCell id="rt2" parent="1" vertex="1" value="&lt;b&gt;Endpoint route table&lt;/b&gt;&lt;br&gt;0.0.0.0/0 → NAT Gateway&lt;br&gt;10.10.0.0/16 → local&lt;br&gt;After inspection, continue onward" style="shape=rectangle;rounded=1;arcSize=6;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=20;fontFamily=Arial;fontSize=25;fontColor=#15283f;fillColor=#f2f0fa;strokeColor=#7fa2c5;strokeWidth=2;">
          <mxGeometry as="geometry" x="920" y="720" width="540" height="200" />
        </mxCell>
        <mxCell id="rt3" parent="1" vertex="1" value="&lt;b&gt;NAT subnet route table&lt;/b&gt;&lt;br&gt;0.0.0.0/0 → IGW&lt;br&gt;10.10.1.0/24 → firewall endpoint&lt;br&gt;Return is inspected after reverse NAT" style="shape=rectangle;rounded=1;arcSize=6;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=20;fontFamily=Arial;fontSize=25;fontColor=#15283f;fillColor=#f2f0fa;strokeColor=#7fa2c5;strokeWidth=2;">
          <mxGeometry as="geometry" x="1690" y="720" width="540" height="200" />
        </mxCell>
        <mxCell id="a" parent="1" edge="1" source="vm" target="fw" value="1 • endpoint route" style="edgeStyle=orthogonalEdgeStyle;html=1;rounded=0;strokeWidth=4;endArrow=block;endFill=1;strokeColor=#2466a8;fontColor=#2466a8;fontSize=22;labelBackgroundColor=#ffffff;exitX=1;exitY=0.25;entryX=0;entryY=0.25;">
          <mxGeometry as="geometry" relative="1" />
        </mxCell>
        <mxCell id="b" parent="1" edge="1" source="fw" target="nat" value="2 • post route" style="edgeStyle=orthogonalEdgeStyle;html=1;rounded=0;strokeWidth=4;endArrow=block;endFill=1;strokeColor=#2466a8;fontColor=#2466a8;fontSize=22;labelBackgroundColor=#ffffff;exitX=1;exitY=0.25;entryX=0;entryY=0.25;">
          <mxGeometry as="geometry" relative="1" />
